# Copy to .env and fill in. Never commit .env.
XAI_API_KEY=
TROVA_MODEL=grok-4.7          # try grok-4.20-0309-non-reasoning if finds are slow
TROVA_EFFORT=low              # low | medium | high | xhigh ; empty = API default (high, slower)
TROVA_GROK_TIMEOUT_S=60       # give up on one Grok answer after this long
TROVA_TOKEN=                  # set a secret on the venue Wi-Fi: open the printed link (?token=...) once per device
TROVA_OFFLINE_FALLBACK=1      # Wi-Fi or xAI down: answer locally (colour match), badge shows OFFLINE
TROVA_MOCK=auto               # auto = mock when no key; 1 = force mock
TROVA_CAMERA=demo             # demo | 0 | 1 (iPhone Continuity Camera is usually 1) | path/to/video.mp4 | folder/
TROVA_ARM=sim                 # sim | ur:<ip> (UR3e/UR5e) | xarm:<ip> (xArm5) | elite:<ip> (CS63/CS66) | cartesian:fake
# Real cobot safety (robot base frame, millimetres). Measure on the station before the first move.
TROVA_ARM_Z_MM=150            # tip height while pointing: table surface + 30-50 mm
TROVA_ARM_HOME_MM=            # REQUIRED for a real arm: x,y,z parked pose out of the camera's view, e.g. 250,-350,300
TROVA_ARM_LIMITS=             # REQUIRED for a real arm: xmin,xmax,ymin,ymax,zmin,zmax (robot mm); moves outside are refused
TROVA_ARM_SPEED_MM_S=100      # keep low with people around the table
TROVA_ARM_TCP_MM=             # xArm: pointer length on the flange, e.g. 0,0,120 (empty = flange / set in UFACTORY Studio)
# EXPERIMENTAL tray lift with the fork (feature 7). Measure on the real tray with staff before enabling.
TROVA_ALLOW_LIFT=0
TROVA_TRAY_Z_SLOT_MM=30       # tool height when the fork enters the tray slot (robot frame)
TROVA_TRAY_INSERT_MM=40       # how far the fork slides in
TROVA_TRAY_LIFT_MM=40         # how high the tray is lifted
TROVA_TRAY_STANDOFF_MM=60     # clearance before the slot
TROVA_TRAY_APPROACH=0,1       # direction the fork travels into the slot, robot XY
TROVA_TABLE_W_MM=600          # table area the camera sees, used by the default calibration + sim arm
TROVA_TABLE_H_MM=400
TROVA_BLOB_THRESH=30          # raise if shadows/glare become objects, lower if pale objects are missed
TROVA_MIN_AREA_FRAC=0.0008    # smallest object as a fraction of the frame
TROVA_PORT=8000
TROVA_LANG=en                 # change reports: en | it | both  (finds and voice answer in the language you use)
TROVA_VOICE_MODEL=grok-voice-latest
TROVA_VOICE=eve
TROVA_DOG=off                 # optional dog: off | sim (replays data/dog_route/*.jpg) | go2:<ip> (template)
