[Unit]
Description=trova-cam camera server (live page, snapshots, heat protection)
After=network.target

[Service]
User=trova
SupplementaryGroups=video
WorkingDirectory=/home/trova/trova-stream
ExecStart=/usr/bin/python3 -u /home/trova/trova-stream/stream.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
